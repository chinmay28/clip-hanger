<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the icon: the app's own settings, reachable whatever the
     server's web page offers (an older server has no button for them, and an
     unreachable one shows nothing at all). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="settings"
        android:shortcutShortLabel="@string/settings_short">
        <intent
            android:action="io.github.chinmay28.cliphanger.SETTINGS"
            android:targetClass="io.github.chinmay28.cliphanger.SettingsActivity"
            android:targetPackage="io.github.chinmay28.cliphanger" />
    </shortcut>
</shortcuts>
