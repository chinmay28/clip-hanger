<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClipHanger" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/clip_accent</item>
        <item name="colorOnPrimary">@color/clip_bg</item>
        <item name="colorSecondary">@color/clip_accent_bright</item>
        <item name="android:colorBackground">@color/clip_bg</item>
        <item name="colorSurface">@color/clip_surface</item>
        <item name="android:windowBackground">@color/clip_bg</item>
        <item name="android:statusBarColor">@color/clip_bg</item>
        <item name="android:navigationBarColor">@color/clip_bg</item>
    </style>

    <!-- No window action bar: the screen has its own toolbar, which it can
         keep out from under the status bar on an edge-to-edge Android. -->
    <style name="Theme.ClipHanger.Settings" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/clip_accent</item>
        <item name="colorOnPrimary">@color/clip_bg</item>
        <item name="colorSecondary">@color/clip_accent_bright</item>
        <item name="android:colorBackground">@color/clip_bg</item>
        <item name="colorSurface">@color/clip_bg</item>
        <item name="android:windowBackground">@color/clip_bg</item>
    </style>

    <!-- The player: black behind the picture, nothing else. -->
    <style name="Theme.ClipHanger.Player" parent="Theme.ClipHanger">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.ClipHanger.Invisible" parent="Theme.ClipHanger">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The developer badge thrown up full screen (see DevFlash). -->
    <style name="Theme.ClipHanger.DevFlash" parent="Theme.ClipHanger">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
